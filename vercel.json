{
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/ai.js": {
      "maxDuration": 120,
      "memory": 1024,
      "includeFiles": ["server/**", "src/ai/**", "src/providers/**", "src/shared/**"]
    },
    "api/test.js": {
      "maxDuration": 30,
      "memory": 512,
      "includeFiles": ["server/**", "src/ai/**", "src/providers/**", "src/shared/**"]
    }
  }
}
