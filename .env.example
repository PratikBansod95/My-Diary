# Copy to .env for local `npm run dev` (never commit the real key).
OPENROUTER_API_KEY=
# Fast vision default in code: google/gemini-2.0-flash-001
# Free (slower / may 504 on Vercel): openrouter/free  or  nvidia/nemotron-nano-12b-v2-vl:free
# OPENROUTER_MODEL=google/gemini-2.0-flash-001
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
